{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "herdsidian-chrome"
          },
          "size": {
            "px": 52
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "guide-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "guide-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "herdsidian-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 80
          }
        }
      ],
      "size": {
        "px": 248
      },
      "min": 44,
      "max": 480,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "herdsidian-tabs"
          },
          "size": {
            "px": 52
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "herdsidian-pane"
                    },
                    "reveal": "always",
                    "height": 34,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "#ffffff12"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 12,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "herdsidian-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    },
    {
      "id": "herdsidian",
      "type": "block",
      "hidden": true,
      "size": {
        "px": 380
      },
      "min": 44,
      "max": 720,
      "content": {
        "mod": "herdsidian"
      }
    }
  ],
  "background": {
    "gradient": [
      "chrome",
      "canvas"
    ],
    "angle": 160
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "#ffffff12"
  },
  "titlebar": "none",
  "traffic_lights": [
    16,
    19
  ],
  "theme": "herdsidian_carbon",
  "terminal_opacity": 1,
  "ui_font": ".AppleSystemUIFont"
}
